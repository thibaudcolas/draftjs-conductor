{
  "name": "draftjs-conductor",
  "version": "3.0.0",
  "description": "📝✨ Little Draft.js helpers to make rich text editors “just work”",
  "author": "Thibaud Colas",
  "license": "MIT",
  "main": "dist/draftjs-conductor.cjs.js",
  "module": "dist/draftjs-conductor.esm.js",
  "types": "dist/draftjs-conductor.d.ts",
  "sideEffects": false,
  "keywords": [
    "draftjs",
    "draft-js",
    "editor",
    "react",
    "wysiwyg",
    "rich text",
    "richtext",
    "rte"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thibaudcolas/draftjs-conductor.git"
  },
  "bugs": {
    "url": "https://github.com/thibaudcolas/draftjs-conductor/issues"
  },
  "homepage": "https://thibaudcolas.github.io/draftjs-conductor/",
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "browserslist": "> 1%, not IE 11",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@testing-library/react": "12.1.5",
    "@types/draft-js": "0.11.18",
    "@types/react": "16.14.26",
    "@types/react-dom": "16.9.16",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "5.0.1",
    "draft-js": "0.11.7",
    "draft-js-10": "npm:draft-js@0.10.5",
    "immutable": "~3.7.6",
    "jsdom": "24.1.1",
    "normalize.css": "8.0.1",
    "prettier": "3.9.9",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "draft-js": "^0.10.4 || ^0.11.0 || ^0.12.0"
  },
  "scripts": {
    "dev": "vp dev",
    "start": "vp dev",
    "build": "tsc && vp build && vp pack",
    "preview": "vp preview",
    "test": "vp test run --coverage.enabled",
    "test:watch": "vp test watch",
    "report:coverage": "open coverage/0.11/index.html",
    "report:package": "npm pack --dry-run --loglevel notice 2>&1 >/dev/null | sed -e 's/^npm notice //' | tee dist/package.txt",
    "lint": "vp check && vp lint --deny-warnings && prettier --check 'docs/flow-typed/**/*.js'",
    "format": "vp fmt && prettier --write 'docs/flow-typed/**/*.js'",
    "test:ci": "npm run lint -s && npm run build -s && npm run test:versions",
    "prepare": "vp config --no-agent",
    "prepublishOnly": "npm run build -s",
    "test:versions": "DRAFTJS_VERSION=0.11 npm test && DRAFTJS_VERSION=0.10 npm test"
  },
  "overrides": {
    "isomorphic-fetch": {
      "node-fetch": "^2.0.0"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  }
}
