{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  commitBodyTable: true,
  dependencyDashboard: false,
  // These versions define the supported legacy editor environment.
  ignoreDeps: [
    "immutable",
    "@types/draft-js",
    "draft-js",
    "draft-js-10",
    "normalize.css",
    "@types/react",
    "@types/react-dom",
    "react",
    "react-dom",
    "@testing-library/react",
  ],
  labels: ["enhancement"],
  prCreation: "immediate",
  semanticCommits: "enabled",
  commitMessageTopic: "{{depName}}",
  prBodyColumns: ["Package", "Update", "Type", "Change"],
  schedule: ["every weekend"],
  prHourlyLimit: 2,
  // Branch rules require PRs. Renovate must wait for CI itself because GitHub
  // auto-merge is disabled and the ruleset has no required status checks.
  automergeType: "pr",
  platformAutomerge: false,
  automergeStrategy: "squash",
  rebaseWhen: "behind-base-branch",
  automerge: false,
  // Node follows the latest stable release by default and requires manual review.
  // Security updates still need the same compatibility review as other majors.
  vulnerabilityAlerts: { automerge: false },
  packageRules: [
    {
      matchPackageNames: [
        "prettier",
        "typescript",
        "jsdom",
        "@commitlint/*",
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vite",
        "@vitejs/plugin-react-swc",
        "vitest",
        "@vitest/coverage-v8",
      ],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      matchPackageNames: [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vite",
        "@vitejs/plugin-react-swc",
        "vitest",
        "@vitest/coverage-v8",
      ],
      groupName: "vite-plus",
      // CI verifies the bundled Vitest, coverage provider and Vite core match.
    },
    {
      matchPackageNames: ["@commitlint/*"],
      groupName: "commitlint",
    },
    {
      matchPackageNames: ["semantic-release", "@semantic-release/*"],
      groupName: "semantic-release",
      // Publishing is only exercised after merging to main.
      automerge: false,
    },
    {
      matchManagers: ["github-actions"],
      groupName: "actions",
      // Deployment and publishing actions are not exercised by PR checks.
      automerge: false,
    },
    {
      matchPackageNames: ["node-fetch"],
      // isomorphic-fetch calls require("node-fetch") as a function; v3 is ESM.
      allowedVersions: "<3",
    },
    {
      matchPackageNames: ["node-fetch"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
  ],
}
